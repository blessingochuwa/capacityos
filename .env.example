# CapacityOS — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- apps/api ---
# SQLite for local development; must remain PostgreSQL-compatible in production.
DATABASE_URL=sqlite:///./capacityos.db
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- apps/api: Phase 9 production readiness (all optional — safe defaults
# below). ENVIRONMENT=production enables a startup-time configuration
# safety check (see docs/adr/0009-phase-9-production-readiness.md) that
# refuses to start if DATABASE_URL is still SQLite, AI_PROVIDER is still
# "mock", or API_CORS_ORIGINS is empty/a wildcard — never enable it without
# also setting those to real production values.
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=5242880

# --- apps/api: Phase 10 authentication/RBAC/audit (all optional — safe
# defaults below). No SESSION_SECRET_KEY exists: session tokens are random
# opaque values compared by hash, never signed/encrypted, so there is
# nothing to provision or rotate. Session cookies are automatically Secure
# (HTTPS-only) whenever ENVIRONMENT=production — this is NOT a separate
# setting an operator could forget to flip. See
# docs/adr/0010-authentication-rbac-audit.md. To create the first Owner
# account, run scripts/create_first_owner.py — there is no open
# self-registration.
SESSION_TTL_HOURS=24

# --- apps/api: Phase 8 AI insight layer (all optional — CapacityOS runs
# completely normally with none of these set; AI features simply report
# themselves as unavailable). Never set ANTHROPIC_API_KEY in apps/web.
# AI_PROVIDER: "anthropic" to enable real AI explanations, "mock" for a
# deterministic canned provider (dev/demo only, never for production
# decision support), or unset/"none" (default) to disable AI entirely.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_SECONDS=30

# --- apps/web ---
VITE_API_URL=http://localhost:8000
